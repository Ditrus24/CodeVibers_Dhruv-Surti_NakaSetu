# ==============================================================================
# NakaSetu Environment Configuration (100% Free Tier Services Only)
# ==============================================================================
# Copy this file to '.env' for local development or add these keys to your
# hosting provider's Environment Variables dashboard (Vercel / Render / Netlify).

# ------------------------------------------------------------------------------
# 1. Application Base URL
# ------------------------------------------------------------------------------
# Used for metadata, canonical URLs, and shareable links.
# Local: http://localhost:3000
# Production: https://code-vibers-dhruv-surti-naka-setu-ten.vercel.app
VITE_APP_URL="https://code-vibers-dhruv-surti-naka-setu-ten.vercel.app"

# ------------------------------------------------------------------------------
# 2. Optional Free Geolocation & Map Services (Free Tiers)
# ------------------------------------------------------------------------------
# Mapbox (Free tier: 50,000 monthly map loads free): https://account.mapbox.com/
VITE_MAPBOX_TOKEN=""

# ------------------------------------------------------------------------------
# 3. Optional Free SMS / IVR Notification Gateways (Free Tiers / Sandboxes)
# ------------------------------------------------------------------------------
# Twilio Sandbox (Free trial credit): https://www.twilio.com/try-twilio
VITE_TWILIO_ACCOUNT_SID=""
VITE_TWILIO_AUTH_TOKEN=""
VITE_TWILIO_PHONE_NUMBER=""

